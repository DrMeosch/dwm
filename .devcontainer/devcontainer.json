{
  "name": "app",
  "build": {
    // Path is relative to the devcontainer.json file.
    "dockerfile": "Dockerfile.dev"
  },
  "workspaceFolder": "/app",
  "mounts": [
    "source=${localWorkspaceFolder},target=/app/projects,type=bind",
    // "source=${localWorkspaceFolder}/../frontend,target=/workspace/frontend,type=bind,readonly",
    "source=/shared,target=/shared,type=bind,readonly",
    "source=dwm-home,target=/home/node/.codex,type=volume",
    "source=${localEnv:HOME}/.codex/config.toml,target=/etc/codex/config.toml,type=bind,readonly"
  ],
  "shutdownAction": "stopContainer",
  "remoteUser": "node",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/jungaretti/features/make:1": {},
    "ghcr.io/jungaretti/features/ripgrep:1": {},
    "ghcr.io/eitsupi/devcontainer-features/jq-likes:2": {},
    "ghcr.io/devcontainers-extra/features/uv:1": {},
    "ghcr.io/ttyrho/devcontainer-features/gcc:1": {}
  },
  // "postCreateCommand": "cd /app/src && uv sync",
  // "postCreateCommand": "npm ci",
  "postCreateCommand": "sudo chown -R node:node /home/node/.codex",
  "remoteEnv": {
    "PATH": "/home/node/.venv/bin:${containerEnv:PATH}"
  },
  "containerEnv": {
    "LITELLM_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "GH_TOKEN": "${localEnv:GITHUB_TOKEN}"
  },
  // "runArgs": ["--env-file",".devcontainer/devcontainer.env"]
  "customizations": {
    "vscode": {
      "extensions": []
    }
  },
  "forwardPorts": []
}
