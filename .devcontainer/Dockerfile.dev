FROM python:3.14-slim-bookworm@sha256:48b13b003dda20b16f9442b8475aa05fe21bf6579a8c881db92ffb4d8fd20f83 AS python

FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS dev

COPY --from=python /usr/local/ /usr/local/

# Runtime libraries for Python and its standard-library extensions.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libbluetooth3 \
      libbz2-1.0 \
      libcrypt1 \
      libdb5.3 \
      libexpat1 \
      libffi8 \
      libgdbm6 \
      libgdbm-compat4 \
      liblzma5 \
      libncursesw6 \
      libreadline8 \
      libsqlite3-0 \
      libssl3 \
      libtinfo6 \
      libuuid1 \
      libzstd1 \
      zlib1g \
      libx11-dev \
      libxinerama-dev \
      libxft-dev \
      libx11-xcb-dev \
      libxcb1-dev \
      libxcb-res0-dev \
      libfontconfig1-dev \
      curl \
      tmux \
      ca-certificates \
      tar \
      build-essential \
      tmux \
      # docker-cli \
      # docker-buildx \
      # docker-compose \
      # redis-tools \
    && ldconfig \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /app /home/node/.local/npm/bin /home/node/.codex /home/node/.claude
RUN chown -R node:node /app /home/node

ENV PATH="/home/node/.local/bin:/home/node/.local/npm/bin:${PATH}"
ENV NPM_CONFIG_PREFIX=/home/node/.local/npm

ENV CODEX_HOME=/home/node/.codex
ENV PATH=/home/node/.codex/bin:${PATH}

USER node

WORKDIR /app

ARG FIRSTMATE_REF=20dcbf91520b1816663b81873ad67d0b93b3e4d6
RUN curl -fsSL -o /tmp/firstmate.tar.gz "https://github.com/kunchenguid/firstmate/archive/${FIRSTMATE_REF}.tar.gz" \
  && tar -xzf /tmp/firstmate.tar.gz --strip-components=1 \
  && rm /tmp/firstmate.tar.gz

RUN mkdir -p /app/projects && chown node:node /app/projects
