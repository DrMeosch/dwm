_pkgname=dwm
pkgname=$_pkgname-drmeosch-git
pkgver=6.5
pkgrel=1
pkgdesc="DrMeosch's build of dwm"
url=https://github.com/drmeosch/dwm
arch=(i686 x86_64)
license=(MIT)
makedepends=(git)
depends=(fontconfig freetype2 libx11 libxcb libxft libxinerama)
optdepends=(
	'dmenu: program launcher'
	'st: terminal emulator')
provides=($_pkgname)
conflicts=($_pkgname)
source=(git+https://github.com/drmeosch/dwm.git)
sha256sums=('SKIP')

pkgver() {
	cd "$_pkgname"
	echo "$(awk '/^VERSION =/ {print $3}' src/config.mk)".r"$(git rev-list --count HEAD)"."$(git rev-parse --short HEAD)"
}

prepare() {
	cd "$_pkgname"
	echo "CPPFLAGS+=${CPPFLAGS}" >> src/config.mk
	echo "CFLAGS+=${CFLAGS}" >> src/config.mk
	echo "LDFLAGS+=${LDFLAGS}" >> src/config.mk
	# to use a custom config.h, place it in the package directory
	if [[ -f ${SRCDEST}/config.h ]]; then
		cp "${SRCDEST}/config.h" src/config.h
	fi
}

build() {
	cd "$_pkgname"
	# -march=native from src/config.mk would make the package host-specific
	make OPTIMISATIONS= X11INC=/usr/include/X11 X11LIB=/usr/lib/X11
}

package() {
	cd "$_pkgname"
	make PREFIX=/usr DESTDIR="$pkgdir" install
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
